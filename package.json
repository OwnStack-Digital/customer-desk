{
  "name": "bos",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:api": "cd apps/backend && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "build": "bun run build:api && bun run build:web",
    "build:api": "cd apps/backend && bun run build",
    "build:web": "cd apps/web && bun run build",
    "start:api": "cd apps/backend && bun run start",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/backend/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check apps scripts",
    "format": "biome check --write apps scripts",
    "arch": "bun scripts/architecture-check.ts",
    "check": "bun run arch && bun run lint && bun run typecheck && bun run test",
    "db:migrate": "cd apps/backend && bun run db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}