# BOS backend (see docs/PLAN.md "Env"). Copy to `.env` and fill in secrets locally.
# Never commit real values for BOS_OWNER_PASSWORD or BOS_INGRESS_KEY.

# Postgres connection string. Local Docker Compose default.
DATABASE_URL=postgres://bos:bos@127.0.0.1:5432/bos
# `postgres` (default) or `sqlite` (tests/dev only).
DB_DIALECT=postgres
# Directory with the four config JSON files. Empty = repo `config/`.
CONFIG_DIR=
# Seed owner, created only when no operator credentials exist.
BOS_OWNER_EMAIL=owner@harbourandpine.example
BOS_OWNER_PASSWORD=
# Bearer token for POST /inbound/emails. Keep empty locally until needed.
BOS_INGRESS_KEY=
# Public URL of the web app, used to build quote links.
PUBLIC_APP_URL=http://127.0.0.1:3000
# `true` only when serving over HTTPS.
COOKIE_SECURE=false
# Backend HTTP port (default 3001).
PORT=3001

# Web app
# Server-only base URL of the BOS API.
BOS_API_URL=http://127.0.0.1:3001
# Web dev server port (default 3000).
WEB_PORT=3000